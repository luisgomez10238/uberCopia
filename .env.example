# Copia este archivo como .env y completa los valores. No subas .env a Git.
# Firebase (consola de Firebase > Configuración del proyecto > Tus apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary (subida de fotos con upload preset sin firma)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# URL del backend de pagos (IP de tu PC en la red Wi-Fi, no localhost)
EXPO_PUBLIC_BACKEND_URL=
